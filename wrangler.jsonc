{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piotr-moj-pt",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": false
  },
  "send_email": [{ "name": "EMAIL" }],
  "secrets": {
    "required": ["OWNER_EMAIL", "SERVICE_EMAIL", "TURNSTILE_SECRET_KEY"],
  },
}
